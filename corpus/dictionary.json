  "view_text": {
    "LINEAGE.V_CUSTOMER_EDITABLE": "SELECT d.cust_id,\n       d.region,\n       d.is_active,\n       s.email AS source_email\n  FROM dim_customer d\n  JOIN stg_customer s ON s.cust_id = d.cust_id",
    "LINEAGE.V_CUST_L1": "SELECT cust_id      AS id,\n       region       AS region,\n       last_login   AS login_ts,\n       status_code  AS status\n  FROM stg_customer",
    "LINEAGE.V_CUST_L2": "SELECT id           AS cust_id,\n       region,\n       login_ts,\n       CASE WHEN status = 1 THEN 1 ELSE 0 END AS status_flag\n  FROM v_cust_l1",
    "LINEAGE.V_CUST_L3": "SELECT cust_id,\n       region,\n       login_ts     AS last_login,\n       status_flag\n  FROM v_cust_l2",
    "LINEAGE.V_RECENT_RAW": "SELECT cust_id, last_login\n  FROM stg_customer\n WHERE last_login IS NOT NULL"
  }
