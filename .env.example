# Copy to .env (same folder as docker-compose.review.yml) and fill in. .env is gitignored.

# Claude API key for the "Ask the lineage" view. Leave blank to use only the Parse SQL and
# Lineage graph views. Create one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Host port for the UI (default 8501).
# APP_PORT=8501
