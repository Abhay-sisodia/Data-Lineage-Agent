# Answer key for B2 t2_depth.sql - subqueries, CTEs, set operations: depth.
#
# WRITTEN FROM SOURCE BEFORE THE ANALYSER WAS RUN OVER THIS FILE.
# Conventions as T1; D-12 and D-13 not yet implemented.

@ 18 S1 an IN inside a scalar subquery, correlated to the outermost query
value customers.id -> customer_summary.customer_id identity
value payments.amount, payments.order_id, orders.id, orders.customer_id, customers.id, orders.channel -> customer_summary.lifetime_value aggregated
note D-12 covers the whole scalar subquery, the nested IN included: it all decides which payments are summed.
forbid filter payments.order_id -> customer_summary | inside a SELECT-list scalar subquery, however deep (D-12)

@ 37 S2 a scalar comparison inside an EXISTS
value dim_customer.customer_id -> customer_summary.customer_id identity
value dim_customer.full_name -> customer_summary.full_name identity
filter dim_customer.is_current, dim_customer.customer_key, fct_order_line.customer_key, fct_order_line.net_amount, fct_order_line.store_id -> customer_summary
filter fct_order_line.net_amount -> customer_summary post
note net_amount is compared directly (pre) and through AVG (post): one column, two facts.

@ 58 S3 eight CTEs, a UNION ALL in the middle, a window near the end
value orders.customer_id, returns.order_line_id -> customer_summary.customer_id identity
value orders.amount, returns.amount -> customer_summary.lifetime_value aggregated
influence orders.customer_id, returns.order_line_id -> customer_summary.lifetime_value
influence orders.amount, returns.amount, orders.customer_id, returns.order_line_id -> customer_summary.value_decile
note NTILE orders by `value`, a SUM per customer: the summed amounts and the grouping both reach it.
filter orders.status, orders.channel -> customer_summary
filter orders.amount, returns.amount -> customer_summary post
note `WHERE s4.net > 0` filters the SUM (D-6). The 'order'/'return' kind literal goes nowhere.

@ 107 S4 a UNION in a derived table in a CTE, then a correlated scalar subquery
value customers.id, dim_customer.customer_id -> top_customers.customer_id identity
value customers.full_name, dim_customer.full_name -> top_customers.full_name identity
value orders.amount, orders.customer_id, customers.id, dim_customer.customer_id -> top_customers.revenue aggregated
note D-12: the correlation operand pe.k is fed by BOTH union arms.
filter dim_customer.is_current -> top_customers
forbid filter orders.customer_id -> top_customers | the scalar subquery's correlation removes no row (D-12)

@ 131 S5 a LATERAL with GROUP BY and a LIMIT, in a CTE
value fct_order_line.product_key -> product_performance.product_id identity
value dim_store.region -> product_performance.category_name identity
value fct_order_line.quantity -> product_performance.units aggregated
influence fct_order_line.product_key -> product_performance.units
filter fct_order_line.store_id, dim_store.id -> product_performance
filter fct_order_line.quantity -> product_performance post
note D-9 + D-6: the LIMIT 5 is ordered by SUM(quantity).

@ 153 S6 recursion feeding two levels of aggregation
value dim_category.department -> channel_mix.channel identity
value fct_order_line.net_amount -> channel_mix.revenue aggregated
influence dim_product.category_id, dim_category.department -> channel_mix.revenue
filter dim_category.parent_id -> channel_mix
note The anchor's WHERE picks the roots. All three joins - the recursion and both CTE joins - are structural.

@ 185 S7 NOT EXISTS over a derived UNION ALL
value orders.channel -> channel_mix.channel identity
value orders.currency -> channel_mix.region identity
value orders.id -> channel_mix.orders identity
filter returns.order_line_id, payments.order_id, payments.status, orders.id -> channel_mix

@ 205 S8 an IN over a grouped, HAVING-filtered subquery
value fct_order_line.store_id -> sales_daily.store_id identity
value fct_order_line.net_amount -> sales_daily.net_amount identity
filter fct_order_line.customer_key -> sales_daily
filter fct_order_line.order_id -> sales_daily post

@ 224 S9 an ordered pick from a CTE inside a scalar subquery
value dim_carrier.id -> carrier_scorecard.carrier_id identity
value shipments.order_id -> carrier_scorecard.carrier_name derived
value shipments.carrier_id, dim_carrier.id, shipments.status -> carrier_scorecard.carrier_name conditional
note The CTE's `status <> 'LOST'` is reached only through the scalar subquery: D-12's reasoning makes it a value, not a filter.
influence shipments.shipped_at -> carrier_scorecard.carrier_name
forbid filter shipments.status -> carrier_scorecard | the CTE is read only inside a SELECT-list scalar subquery, so it removes no row (D-12)
forbid filter shipments.shipped_at -> carrier_scorecard | an ordered pick in a scalar subquery (D-13)

@ 243 S10 a UNION ALL inside a scalar subquery
value dim_store.region -> kpi_rollup.region identity
value orders.amount, payments.amount, orders.store_id, dim_store.id -> kpi_rollup.revenue aggregated
forbid filter orders.store_id -> kpi_rollup | a correlation inside a SELECT-list scalar subquery (D-12)
