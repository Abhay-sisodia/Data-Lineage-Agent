# Answer key for B2 t2_depth.sql - subqueries, CTEs, set operations: depth.
#
# WRITTEN FROM SOURCE BEFORE THE ANALYSER WAS RUN OVER THIS FILE.
# Conventions as T1; D-12 and D-13 not yet implemented.

@ 18 S1 an IN inside a scalar subquery, correlated to the outermost query
value staging.customers.id -> mart.customer_summary.customer_id identity
value staging.payments.amount, staging.payments.order_id, staging.orders.id, staging.orders.channel -> mart.customer_summary.lifetime_value aggregated
# D-58: staging.customers.id matched the aggregated lookup's rows to mart.customer_summary.lifetime_value's - influence, as a GROUP BY is (was a value).
influence staging.customers.id -> mart.customer_summary.lifetime_value
# D-58: staging.orders.customer_id -> mart.customer_summary.lifetime_value is a lookup key (join_key, not scored; was an aggregated value).
note D-12 covers the whole scalar subquery, the nested IN included: it all decides which payments are summed.
forbid filter staging.payments.order_id -> mart.customer_summary | inside a SELECT-list scalar subquery, however deep (D-12)

@ 37 S2 a scalar comparison inside an EXISTS
value core.dim_customer.customer_id -> mart.customer_summary.customer_id identity
value core.dim_customer.full_name -> mart.customer_summary.full_name identity
filter core.dim_customer.is_current, core.dim_customer.customer_key, core.fct_order_line.customer_key, core.fct_order_line.net_amount, core.fct_order_line.store_id -> mart.customer_summary
filter core.fct_order_line.net_amount -> mart.customer_summary post
note net_amount is compared directly (pre) and through AVG (post): one column, two facts.

@ 58 S3 eight CTEs, a UNION ALL in the middle, a window near the end
value staging.orders.customer_id, staging.returns.order_line_id -> mart.customer_summary.customer_id identity
value staging.orders.amount, staging.returns.amount -> mart.customer_summary.lifetime_value aggregated
influence staging.orders.customer_id, staging.returns.order_line_id -> mart.customer_summary.lifetime_value
influence staging.orders.amount, staging.returns.amount, staging.orders.customer_id, staging.returns.order_line_id -> mart.customer_summary.value_decile
note NTILE orders by `value`, a SUM per customer: the summed amounts and the grouping both reach it.
filter staging.orders.status, staging.orders.channel -> mart.customer_summary
filter staging.orders.amount, staging.returns.amount -> mart.customer_summary post
note `WHERE s4.net > 0` filters the SUM (D-6). The 'order'/'return' kind literal goes nowhere.

@ 107 S4 a UNION in a derived table in a CTE, then a correlated scalar subquery
value staging.customers.id, core.dim_customer.customer_id -> mart.top_customers.customer_id identity
value staging.customers.full_name, core.dim_customer.full_name -> mart.top_customers.full_name identity
value staging.orders.amount -> mart.top_customers.revenue aggregated
# D-58: staging.orders.customer_id, staging.customers.id, core.dim_customer.customer_id matched the aggregated lookup's rows to mart.top_customers.revenue's - influence, as a GROUP BY is (was a value).
influence staging.orders.customer_id, staging.customers.id, core.dim_customer.customer_id -> mart.top_customers.revenue
note D-12: the correlation operand pe.k is fed by BOTH union arms.
filter core.dim_customer.is_current -> mart.top_customers
forbid filter staging.orders.customer_id -> mart.top_customers | the scalar subquery's correlation removes no row (D-12)

@ 131 S5 a LATERAL with GROUP BY and a LIMIT, in a CTE
value core.fct_order_line.product_key -> mart.product_performance.product_id identity
value core.dim_store.region -> mart.product_performance.category_name identity
value core.fct_order_line.quantity -> mart.product_performance.units aggregated
influence core.fct_order_line.product_key -> mart.product_performance.units
filter core.fct_order_line.store_id, core.dim_store.id -> mart.product_performance
filter core.fct_order_line.quantity -> mart.product_performance post
note D-9 + D-6: the LIMIT 5 is ordered by SUM(quantity).

@ 153 S6 recursion feeding two levels of aggregation
value core.dim_category.department -> mart.channel_mix.channel identity
value core.fct_order_line.net_amount -> mart.channel_mix.revenue aggregated
influence core.dim_product.category_id, core.dim_category.department -> mart.channel_mix.revenue
filter core.dim_category.parent_id -> mart.channel_mix
note The anchor's WHERE picks the roots. All three joins - the recursion and both CTE joins - are structural.

@ 185 S7 NOT EXISTS over a derived UNION ALL
value staging.orders.channel -> mart.channel_mix.channel identity
value staging.orders.currency -> mart.channel_mix.region identity
value staging.orders.id -> mart.channel_mix.orders identity
filter staging.returns.order_line_id, staging.payments.order_id, staging.payments.status, staging.orders.id -> mart.channel_mix

@ 205 S8 an IN over a grouped, HAVING-filtered subquery
value core.fct_order_line.store_id -> mart.sales_daily.store_id identity
value core.fct_order_line.net_amount -> mart.sales_daily.net_amount identity
filter core.fct_order_line.customer_key -> mart.sales_daily
filter core.fct_order_line.order_id -> mart.sales_daily post

@ 224 S9 an ordered pick from a CTE inside a scalar subquery
value core.dim_carrier.id -> mart.carrier_scorecard.carrier_id identity
value staging.shipments.order_id -> mart.carrier_scorecard.carrier_name derived
value staging.shipments.status -> mart.carrier_scorecard.carrier_name conditional
# D-58: staging.shipments.carrier_id, core.dim_carrier.id -> mart.carrier_scorecard.carrier_name is a lookup key (join_key, not scored; was a conditional value).
note The CTE's `status <> 'LOST'` is reached only through the scalar subquery: D-12's reasoning makes it a value, not a filter.
influence staging.shipments.shipped_at -> mart.carrier_scorecard.carrier_name
forbid filter staging.shipments.status -> mart.carrier_scorecard | the CTE is read only inside a SELECT-list scalar subquery, so it removes no row (D-12)
forbid filter staging.shipments.shipped_at -> mart.carrier_scorecard | an ordered pick in a scalar subquery (D-13)

@ 243 S10 a UNION ALL inside a scalar subquery
value core.dim_store.region -> mart.kpi_rollup.region identity
value staging.orders.amount, staging.payments.amount -> mart.kpi_rollup.revenue aggregated
# D-58: staging.orders.store_id, core.dim_store.id matched the aggregated lookup's rows to mart.kpi_rollup.revenue's - influence, as a GROUP BY is (was a value).
influence staging.orders.store_id, core.dim_store.id -> mart.kpi_rollup.revenue
forbid filter staging.orders.store_id -> mart.kpi_rollup | a correlation inside a SELECT-list scalar subquery (D-12)
