# Answer key for B2 t4_adversarial.sql - subquery scoping traps.
#
# WRITTEN FROM SOURCE BEFORE THE ANALYSER WAS RUN OVER THIS FILE.
# The forbidden list is the test: each forbidden edge is what outward-first or by-name
# resolution produces. Conventions as T1; D-12 and D-13 not yet implemented.

@ 18 S1 an inner alias that captures the outer one
value orders.channel -> channel_mix.channel identity
value orders.amount -> channel_mix.revenue identity
filter payments.order_id, payments.id -> channel_mix
forbid filter orders.id -> channel_mix | inside the EXISTS `o` is payments; `o.id` is payments.id, not the outer orders.id

@ 33 S2 unqualified names inside subqueries
value orders.discount_code -> sales_daily.region identity
value orders.amount -> sales_daily.net_amount identity
filter payments.order_id, payments.id, shipments.carrier_id, orders.store_id, shipments.status -> sales_daily
note `id` binds INSIDE (payments has it); `store_id` binds OUTSIDE (only orders has it).
forbid filter orders.id -> sales_daily | unqualified `id` resolves innermost-first, to payments.id

@ 49 S3 a CTE named like a real table
value customers.id -> top_customers.customer_id identity
value customers.segment -> top_customers.region identity
filter customers.status -> top_customers
forbid value orders.customer_id -> top_customers.customer_id | `orders` is the CTE over staging.customers
forbid value orders.channel -> top_customers.region | `orders` is the CTE over staging.customers

@ 64 S4 set-operation arms with swapped aliases
value dim_store.region, dim_warehouse.name -> kpi_rollup.region identity
value dim_store.name, dim_warehouse.region -> kpi_rollup.segment identity
forbid value dim_warehouse.region -> kpi_rollup.region | arms bind by position; the second arm's `region` alias is its SECOND column
forbid value dim_warehouse.name -> kpi_rollup.segment | arms bind by position; the second arm's `segment` alias is its FIRST column

@ 77 S5 NOT IN whose projection is aliased `id`
value customers.id -> customer_summary.customer_id identity
value customers.segment -> customer_summary.segment identity
filter customers.id, orders.customer_id, orders.status -> customer_summary
forbid filter orders.id -> customer_summary | `AS id` names orders.customer_id; orders.id is never read

@ 91 S6 a scalar subquery aliased `amount`, ordered by that alias under a LIMIT
value customers.id -> sales_daily.orders identity
value payments.amount, orders.customer_id, customers.id -> sales_daily.gross_amount aggregated
filter payments.amount, orders.customer_id, customers.id -> sales_daily post
note ORDER BY amount is the OUTPUT column. Its sources are the subquery's value and its D-12 correlation; the MAX makes the cut post-aggregation (D-9, D-6).

@ 108 S7 a derived alias renaming order_id to `id`
value payments.order_id -> channel_mix.orders identity
value payments.amount -> channel_mix.revenue identity
value orders.currency -> channel_mix.channel identity
forbid value payments.id -> channel_mix.orders | `s.id` is payments.order_id renamed

@ 123 S8 a scalar subquery whose projection reads the outer row
value orders.store_id -> carrier_scorecard.carrier_id identity
value payments.paid_at -> carrier_scorecard.avg_transit_days aggregated
value orders.order_ts -> carrier_scorecard.avg_transit_days derived
value payments.order_id, orders.id -> carrier_scorecard.avg_transit_days aggregated
note order_ts is outside the MAX: derived on its own path (D-7). The correlation is D-12's, aggregated because the subquery aggregates.

@ 137 S9 an ORDER BY ... LIMIT inside an EXISTS
value dim_product.product_key -> product_performance.product_id identity
value dim_product.category_name -> product_performance.category_name identity
filter fct_order_line.product_key, dim_product.product_key -> product_performance
forbid filter fct_order_line.order_date -> product_performance | whether a row EXISTS does not depend on which row is first

@ 152 S10 a CTE joined to itself
value fct_order_line.store_id -> sales_daily.store_id identity
value fct_order_line.order_date -> sales_daily.sale_date identity
value fct_order_line.net_amount -> sales_daily.net_amount, sales_daily.gross_amount aggregated
influence fct_order_line.store_id, fct_order_line.order_date -> sales_daily.net_amount, sales_daily.gross_amount

@ 170 S11 an anti-join written as LEFT JOIN ... IS NULL
value customers.full_name -> kpi_rollup.level identity
value customers.country_code -> kpi_rollup.country_code identity
filter orders.id -> kpi_rollup
forbid filter orders.customer_id -> kpi_rollup | the ON is the join (D-5)
forbid filter customers.id -> kpi_rollup | the ON is the join (D-5)
