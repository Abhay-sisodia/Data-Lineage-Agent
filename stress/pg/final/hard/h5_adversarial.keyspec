filter lgx.item_master.item_id, lgx.bill_of_material.component_item_id, lgx.bill_of_material.bom_status -> pg_temp.p14_b
filter lgx.item_master.item_id, lgx.bill_of_material.component_item_id, lgx.bill_of_material.bom_status -> pg_temp.p14_c

