value evt.activity.entity_id -> pg_temp.p12_a.entity_id, pg_temp.p12_b.entity_id identity
value evt.activity.amount -> pg_temp.p12_a.amt_x, pg_temp.p12_b.amt_x, pg_temp.p12_a.amt_y, pg_temp.p12_b.amt_y identity
filter evt.activity.amount -> pg_temp.p12_a
filter evt.activity.amount -> pg_temp.p12_b

@ 232 P13 comma join with the key in WHERE vs JOIN ON (D-11)
value crm.organization.org_name -> pg_temp.p13_a.org_name, pg_temp.p13_b.org_name identity
value lgx.warehouse.warehouse_code -> pg_temp.p13_a.warehouse_code, pg_temp.p13_b.warehouse_code identity
