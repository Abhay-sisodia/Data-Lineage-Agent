# Answer key for E1 (e1_latest_version.sql): latest version per key, one bare SELECT.
#
# WRITTEN FROM SOURCE BEFORE THE ANALYSER WAS RUN OVER THIS FILE (2026-10-07).
# CLOSED WORLD: every <result> column and every filter is stated; any other edge is a false
# positive. Conventions D-1..D-53; targets are <result>.<column> (D-8); nodes are
# schema-qualified (D-25). All facts band 0.
#
# Convention reading flagged for the report: a ROW_NUMBER() ... WHERE rn = 1 dedup reached
# only through a LEFT JOIN (pole, pov) is read as an ORDERING cut under D-45 - its
# partition and order columns INFLUENCE the columns that side feeds (D-13), as the
# torture_names key read a `pos = 1` ordinal cut. If the analyser reads it as a WHERE
# predicate instead (a conditional value), that is a convention question, not a bug.

@ 16 the whole statement

# --- inner spine: pod -> poll -> pol -> poh ---------------------------------------------
value s2p.po_distribution.distribution_id -> <result>.integration_id identity
value s2p.po_header.segment1 -> <result>.po_number identity
value s2p.po_line.line_number -> <result>.line_number derived
value s2p.po_distribution.distribution_num -> <result>.distribution_num identity
value s2p.po_line_location.shipment_num -> <result>.schedule_number derived
value s2p.po_header.vendor_id -> <result>.supplier_id identity
value s2p.po_distribution.quantity_ordered, s2p.po_distribution.quantity_cancelled -> <result>.po_dist_qty derived
note Each COALESCE(x, 0) reads one column: a null guard, derived (D-19).
value s2p.po_line_location.price_override, s2p.po_line.unit_price -> <result>.unit_price conditional
value s2p.po_distribution.last_modification_date_time, s2p.po_line_location.last_modification_date_time -> <result>.aux1_changed_on_dt conditional
value s2p.po_header.type_lookup_code, s2p.po_header.segment1 -> <result>.blanket_agreement_number conditional
note D-51: segment1 reaches blanket_agreement_number only through the CASE.

# --- pole: a ROW_NUMBER dedup on the null side, ordered by a literal ----------------------
value s2p.po_line_ext.attribute12 -> <result>.should_cost_flag identity
value s2p.po_line_ext.attribute1 -> <result>.starting_price_txt derived
influence s2p.po_line_ext.po_line_id -> <result>.should_cost_flag, <result>.starting_price_txt
note The window's ORDER BY 1 orders by the constant 1 (not a position): no source.
forbid filter s2p.po_line_ext.po_line_id -> <result> | a left-joined dedup picks which ext row fills the columns; it removes no result row (D-14, D-45)

# --- pov: the latest version, ordered by GREATEST(COALESCE ...), on the null side ---------
value s2p.po_version.revision_num -> <result>.latest_revision identity
value s2p.po_version.change_order_description -> <result>.change_order_desc identity
influence s2p.po_version.po_header_id, s2p.po_version.submitted_date, s2p.po_version.approved_date -> <result>.latest_revision, <result>.change_order_desc
forbid filter s2p.po_version.submitted_date -> <result> | the version pick is on a LEFT join's null side (D-14, D-45)

# --- pov_sub: an aggregate summary on the null side ---------------------------------------
value s2p.po_version.submitted_date -> <result>.po_submit_on_dt aggregated
influence s2p.po_version.po_header_id -> <result>.po_submit_on_dt, <result>.version_count
note version_count is COUNT(*): no value, only its grouping (D-2).

# --- filters: the inner spine's dedups, the WHERE beside DISTINCT ON, the final WHERE -----
filter s2p.po_distribution.distribution_id, s2p.po_distribution.last_modification_date_time -> <result>
note pod: ROW_NUMBER partition and order, cut to 1 (D-9).
filter s2p.po_line_location.line_location_id, s2p.po_line_location.last_modification_date_time -> <result>
note poll: the same cut through a named window.
filter s2p.po_line.line_status -> <result>
filter s2p.po_header.document_status, s2p.po_header.po_header_id, s2p.po_header.last_modification_date_time, s2p.po_header.created_at -> <result>
note poh: DISTINCT ON key and both tie-breakers decide the surviving row (D-9).
filter s2p.po_distribution.quantity_ordered -> <result>
note deleted_flag ('N') and load_ts (CURRENT_TIMESTAMP) read no column; ORDER BY with no limit gives nothing (D-9).
