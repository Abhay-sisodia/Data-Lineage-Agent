# Answer key for B10 t1_breadth.sql - lexical robustness, breadth.
#
# WRITTEN FROM SOURCE BEFORE THE ANALYSER WAS RUN OVER THIS FILE.
# Conventions: all earlier decisions, plus D-35..D-38 (decided 2026-10-04, not
# implemented). A literal of any spelling, a parameter and a psql variable give no edge.
# NOT EXPRESSIBLE IN A KEY, CHECKED IN THE REPORT: S8, S11 (PREPARE) and S14 (DEALLOCATE)
# are counted with no edges; \copy (before S22) is refused by name; no meta-command is
# counted; no statement is lost to a lexing error.

@ 18 S1 a plain dollar-quoted literal in WHERE
value staging.orders.channel -> mart.channel_mix.channel identity
filter staging.orders.status -> mart.channel_mix

@ 27 S2 a tagged dollar quote holding $$, a quote and a semicolon
value staging.customers.segment -> mart.kpi_rollup.segment derived

@ 35 S3 nested dollar quotes
value core.dim_store.region -> mart.kpi_rollup.region derived

@ 43 S4 an E'' string
value staging.customers.id -> mart.customer_summary.customer_id identity
value staging.customers.full_name -> mart.customer_summary.full_name derived

@ 51 S5 U&'' strings, default escape and UESCAPE
value staging.customers.country_code -> mart.kpi_rollup.country_code identity
value staging.customers.segment -> mart.kpi_rollup.level derived
filter staging.customers.status -> mart.kpi_rollup

@ 60 S6 B'' and X'' bit strings in WHERE
value staging.orders.store_id -> mart.sales_daily.store_id identity
value staging.orders.amount -> mart.sales_daily.gross_amount identity
filter staging.orders.store_id -> mart.sales_daily

@ 69 S7 comments inside a statement
value staging.customers.id -> mart.top_customers.customer_id identity
value staging.customers.full_name -> mart.top_customers.full_name identity
forbid value staging.payments.method -> mart.top_customers.full_name identity | p.method is inside a nested block comment
forbid value staging.payments.method -> mart.kpi_rollup.level identity | the INSERT between S7 and S8 is commented out

@ 93 S9 EXECUTE: the prepared INSERT's edges, here (D-35)
value staging.orders.channel -> mart.kpi_rollup.level identity
value staging.orders.amount -> mart.kpi_rollup.revenue derived
filter staging.orders.status -> mart.kpi_rollup
note $2 is an external value (D-36): o.amount * $2 is derived from o.amount alone.

@ 99 S10 EXECUTE again: the same edges, again
repeat value staging.orders.channel -> mart.kpi_rollup.level identity
repeat value staging.orders.amount -> mart.kpi_rollup.revenue derived
repeat filter staging.orders.status -> mart.kpi_rollup

@ 114 S12 EXECUTE the prepared SELECT
value staging.customers.full_name -> <result>.full_name identity
value staging.customers.email -> <result>.email identity
filter staging.customers.id -> <result>

@ 120 S13 CREATE TABLE AS EXECUTE
value staging.customers.full_name -> mart.cust_pick.full_name identity
value staging.customers.email -> mart.cust_pick.email identity
filter staging.customers.id -> mart.cust_pick

@ 132 S15 EXECUTE after DEALLOCATE
expect source_unavailable p_cust | S15: p_cust was deallocated at S14, so its statement is unknown (D-35)

@ 138 S16 OPERATOR(pg_catalog.||)
value staging.customers.full_name -> mart.customer_summary.segment derived
value staging.customers.email -> mart.customer_summary.segment derived

@ 146 S17 OPERATOR(pg_catalog.*)
value staging.payments.amount -> mart.top_customers.revenue derived

@ 154 S18 pg_trgm's <->
value staging.customers.full_name -> mart.customer_summary.avg_basket derived
value staging.customers.email -> mart.customer_summary.avg_basket derived

@ 162 S19 text search @@ in WHERE
value staging.products.id -> mart.product_performance.product_id identity
filter staging.products.name -> mart.product_performance

@ 171 S20 a user-defined operator in WHERE
value staging.products.brand -> mart.kpi_rollup.segment identity
filter staging.products.sku, staging.products.name -> mart.kpi_rollup

@ 183 S21 a psql variable as a value
value staging.orders.channel -> mart.sales_daily.region identity
filter staging.orders.status -> mart.sales_daily

@ 195 S22 after \echo, \i and \copy
value core.dim_store.region -> mart.channel_mix.region identity
expect source_unavailable deploy/extra_views.sql | \i includes another file's lineage, which this analysis does not have (D-37)
forbid value staging.orders.status -> mart.kpi_rollup.level identity | the INSERT is text inside an \echo

@ 203 S23 a query sent with \gset
forbid value staging.orders.amount -> <result>.top_amount aggregated | \gset writes psql variables, not <result> (D-37)

@ 211 S24 two statements on one line
value staging.customers.id -> mart.kpi_rollup.customers identity
value staging.orders.id -> mart.kpi_rollup.orders identity

@ 219 S25 after empty statements, a statement
value staging.events_log.kind -> mart.events_log.kind identity
