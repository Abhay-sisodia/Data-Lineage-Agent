value staging.shipments.weight_kg -> mart.carrier_scorecard.cost_per_kg derived

@ 190 S8b NATURAL JOIN on the one shared column
value core.dim_warehouse.region -> mart.kpi_rollup.region identity
value core.dim_store.opened_on -> mart.kpi_rollup.segment derived
value core.dim_warehouse.capacity -> mart.kpi_rollup.customers identity

@ 212 S9 GROUP BY, aggregates, HAVING
value core.fct_order_line.order_date -> mart.sales_daily.sale_date identity
value core.fct_order_line.store_id -> mart.sales_daily.store_id identity
value core.fct_order_line.order_id -> mart.sales_daily.orders aggregated
value core.fct_order_line.quantity -> mart.sales_daily.units aggregated
value core.fct_order_line.gross_amount -> mart.sales_daily.gross_amount aggregated
value core.fct_order_line.net_amount -> mart.sales_daily.net_amount, mart.sales_daily.avg_order_value aggregated
influence core.fct_order_line.order_date, core.fct_order_line.store_id -> mart.sales_daily.orders, mart.sales_daily.units, mart.sales_daily.gross_amount, mart.sales_daily.net_amount, mart.sales_daily.avg_order_value
filter core.fct_order_line.unit_price, core.fct_order_line.discount_amount -> mart.sales_daily post
note HAVING MAX(unit_price) and MIN(discount_amount); COUNT(*) has no source.
forbid influence core.fct_order_line.order_date -> mart.sales_daily.sale_date | a grouping key is copied through unchanged; it does not influence itself (D-2)

@ 235 S10a ROLLUP with GROUPING()
value core.dim_store.region -> mart.kpi_rollup.region identity
value core.dim_store.country_code -> mart.kpi_rollup.country_code identity
value core.fct_order_line.order_id -> mart.kpi_rollup.orders aggregated
