# Answer key for t3_interaction.sql - B1 core SELECT, interaction.
#
# WRITTEN FROM SOURCE BEFORE THE ANALYSER WAS RUN OVER THIS FILE.
#
# Where two rules meet, both apply and neither is allowed to swallow the other. The
# common failure this key is built to catch: a window's ORDER BY over an aggregate being
# reported as a VALUE of the rank, or the GROUP BY being lost once a window sits on top.

@ 22 S1 RANK() OVER (ORDER BY SUM(x))
value fct_order_line.product_key -> product_performance.product_id identity
value fct_order_line.net_amount -> product_performance.revenue aggregated
influence fct_order_line.product_key -> product_performance.revenue, product_performance.margin
influence fct_order_line.net_amount -> product_performance.margin
forbid value fct_order_line.net_amount -> product_performance.margin | the rank orders by the SUM; no part of the SUM is in the rank (D-4)

@ 36 S2 ratio to a windowed total
value fct_order_line.order_date -> channel_mix.period_month identity
value fct_order_line.status -> channel_mix.channel identity
value dim_customer.region -> channel_mix.region identity
value fct_order_line.net_amount -> channel_mix.revenue identity
value fct_order_line.gross_amount -> channel_mix.share_of_region derived
value fct_order_line.amount_usd -> channel_mix.share_of_region aggregated
influence dim_customer.region -> channel_mix.share_of_region

@ 53 S3 SUM(x) FILTER (WHERE c) OVER (...)
value fct_order_line.order_line_id -> product_performance.product_id identity
value fct_order_line.order_date -> product_performance.period_month identity
value fct_order_line.net_amount, fct_order_line.status -> product_performance.running_revenue aggregated
influence fct_order_line.product_key, fct_order_line.order_date -> product_performance.running_revenue
forbid filter fct_order_line.status -> product_performance | a FILTER inside a window changes one column's value; every row is still written (D-10)

@ 67 S4 GROUPING SETS with a window over the result
value dim_customer.region -> kpi_rollup.region identity
value dim_customer.segment -> kpi_rollup.segment identity
value fct_order_line.net_amount -> kpi_rollup.revenue aggregated
influence dim_customer.region, dim_customer.segment -> kpi_rollup.revenue
influence dim_customer.region, dim_customer.segment, fct_order_line.net_amount -> kpi_rollup.customers
forbid value fct_order_line.net_amount -> kpi_rollup.customers | DENSE_RANK orders by the SUM; no part of it is in the rank (D-4)

@ 84 S5 CASE inside an aggregate inside a window
value fct_order_line.store_id -> customer_summary.customer_id identity
value fct_order_line.order_date -> customer_summary.last_order_date identity
value fct_order_line.channel, fct_order_line.net_amount -> customer_summary.lifetime_value aggregated
influence fct_order_line.store_id, fct_order_line.order_date -> customer_summary.lifetime_value

@ 98 S6 FULL JOIN, GROUP BY COALESCE of the keys
value fct_shipment.carrier_id, shipments.carrier_id -> carrier_scorecard.carrier_id conditional
value fct_shipment.cost, shipments.weight_kg -> carrier_scorecard.cost_per_kg aggregated
influence fct_shipment.carrier_id, shipments.carrier_id -> carrier_scorecard.shipments, carrier_scorecard.cost_per_kg
note `shipments` is COUNT(*): no value source, but an aggregated column, so the grouping influences it.

@ 113 S7 ordered-set aggregates, one with FILTER
value fct_shipment.carrier_id -> carrier_scorecard.carrier_id identity
value fct_shipment.transit_days, fct_shipment.status -> carrier_scorecard.p50_transit_days aggregated
value fct_shipment.weight_kg -> carrier_scorecard.p90_transit_days aggregated
influence fct_shipment.carrier_id -> carrier_scorecard.p50_transit_days, carrier_scorecard.p90_transit_days
forbid filter fct_shipment.status -> carrier_scorecard | FILTER on an ordered-set aggregate changes that one value (D-10)

@ 129 S8 DISTINCT ON and an unfiltered window together
value dim_customer.region -> top_customers.region identity
value dim_customer.customer_key -> top_customers.customer_id identity
value fct_order_line.net_amount -> top_customers.revenue identity
influence dim_customer.region, fct_order_line.net_amount -> top_customers.position
filter dim_customer.region, fct_order_line.net_amount -> top_customers
note D-9: region is the DISTINCT ON key, net_amount its tie-breaker. The ROW_NUMBER is never filtered, so it adds influence only.

@ 146 S9 ORDER BY SUM(x) DESC LIMIT 10
value dim_customer.customer_id -> top_customers.customer_id identity
value dim_customer.full_name -> top_customers.full_name identity
value fct_order_line.net_amount -> top_customers.revenue aggregated
influence dim_customer.customer_id, dim_customer.full_name -> top_customers.revenue
filter fct_order_line.net_amount -> top_customers post
note D-9 + D-6: the LIMIT keeps the top 10 by a SUM, so the filter acts after aggregation.

@ 164 S10 LAG(SUM(x)) OVER (ORDER BY month)
value fct_order_line.order_date -> product_performance.period_month derived
value fct_order_line.gross_amount -> product_performance.revenue, product_performance.prev_month_revenue, product_performance.growth_pct aggregated
influence fct_order_line.order_date -> product_performance.revenue, product_performance.prev_month_revenue, product_performance.growth_pct

@ 181 S11 mixed grain in one projection
value fct_order_line.order_date -> sales_daily.sale_date identity
value dim_store.region -> sales_daily.region identity
value fct_order_line.order_id -> sales_daily.orders aggregated
value fct_order_line.net_amount -> sales_daily.net_amount, sales_daily.avg_order_value aggregated
influence fct_order_line.order_date, dim_store.region -> sales_daily.orders, sales_daily.net_amount, sales_daily.avg_order_value, sales_daily.rank_in_region
forbid influence fct_order_line.order_date -> sales_daily.sale_date | a grouping key does not influence itself (D-2)
forbid influence dim_store.region -> sales_daily.region | a grouping key does not influence itself (D-2)

@ 201 S12 compound HAVING
value orders.customer_id -> customer_summary.customer_id identity
value orders.id -> customer_summary.lifetime_orders aggregated
value orders.amount -> customer_summary.avg_basket aggregated
influence orders.customer_id -> customer_summary.lifetime_orders, customer_summary.avg_basket
filter orders.store_id, orders.amount -> customer_summary post

@ 218 S13 aggregate + FILTER + HAVING, window, filtered rank
value fct_order_line.order_date -> channel_mix.period_month derived
value fct_order_line.channel -> channel_mix.channel identity
value dim_store.region -> channel_mix.region identity
value fct_order_line.discount_amount -> channel_mix.orders aggregated
note `orders` is COUNT(*) FILTER (WHERE discount_amount > 0): D-10 makes the FILTER column its only value source.
value fct_order_line.net_amount -> channel_mix.revenue, channel_mix.share_of_region aggregated
influence fct_order_line.order_date, fct_order_line.channel, dim_store.region -> channel_mix.orders, channel_mix.revenue, channel_mix.share_of_region
filter fct_order_line.status -> channel_mix
filter fct_order_line.quantity -> channel_mix post
filter dim_store.region, fct_order_line.order_date, fct_order_line.net_amount -> channel_mix post
note D-9: `rnk <= 3` filters a rank partitioned by region and month and ordered by the monthly SUM, so all three decide which rows survive, after aggregation.
forbid filter fct_order_line.discount_amount -> channel_mix | FILTER changes the count, not which rows land (D-10)
