# Answer key for B3 t3_interaction.sql - DML rules meeting query rules.
#
# WRITTEN FROM SOURCE BEFORE THE ANALYSER WAS RUN OVER THIS FILE.
# Conventions: B1/B2 plus D-15..D-18 (not implemented).

@ 16 S1 UPDATE ... FROM a grouped derived table with a rank
value core.fct_order_line.net_amount -> mart.sales_daily.avg_order_value aggregated
influence core.fct_order_line.order_date, core.fct_order_line.store_id, core.dim_store.region -> mart.sales_daily.avg_order_value, mart.sales_daily.rank_in_region
influence core.fct_order_line.net_amount -> mart.sales_daily.rank_in_region
note rank_in_region has no value source: its partition, its ordering SUM and the grouping reach it. HAVING COUNT(*) names no column.
forbid filter core.fct_order_line.order_date -> mart.sales_daily | `r.order_date = sd.sale_date` joins the derived table to the target (D-11)
forbid filter core.fct_order_line.store_id -> mart.sales_daily | `r.store_id = sd.store_id` joins the derived table to the target (D-11)

@ 38 S2 DELETE duplicates via a filtered ROW_NUMBER (D-9)
filter staging.orders.id, staging.orders.customer_id, staging.orders.order_ts, staging.orders.updated_at -> staging.orders

@ 57 S3 upsert of FILTER aggregates and a windowed share
value core.fct_order_line.product_key -> mart.product_performance.product_id identity
value core.fct_order_line.order_date -> mart.product_performance.period_month derived
value core.fct_order_line.net_amount, core.fct_order_line.status -> mart.product_performance.revenue aggregated
value core.fct_order_line.net_amount -> mart.product_performance.revenue_share aggregated
value core.fct_order_line.net_amount, core.fct_order_line.status -> mart.product_performance.growth_pct aggregated
# Relabelled 2026-10-02 under D-19 (B4-02): was `conditional`. NULLIF(x, 0) reads one column.
value mart.product_performance.revenue -> mart.product_performance.growth_pct derived
note growth_pct in DO UPDATE: EXCLUDED.revenue (the FILTER SUM) over NULLIF of the target's own revenue.
influence core.fct_order_line.product_key, core.fct_order_line.order_date -> mart.product_performance.revenue, mart.product_performance.revenue_share, mart.product_performance.growth_pct
forbid filter core.fct_order_line.status -> mart.product_performance | an aggregate FILTER changes one value (D-10)

@ 75 S4 MERGE from a top-10-per-region rank
value core.dim_customer.customer_id -> mart.top_customers.customer_id identity
value core.dim_customer.region -> mart.top_customers.region identity
value core.fct_order_line.net_amount -> mart.top_customers.revenue aggregated
influence core.dim_customer.customer_id, core.dim_customer.region -> mart.top_customers.revenue
filter core.dim_customer.region, core.fct_order_line.net_amount -> mart.top_customers post
note D-9: `rn <= 10` filters a rank partitioned by region and ordered by a SUM - post-aggregation.

@ 101 S5 UPDATE ... RETURNING grouped by the next write
value core.fct_payment.method -> mart.channel_mix.channel identity
value core.fct_payment.amount_usd -> mart.channel_mix.revenue aggregated
influence core.fct_payment.method -> mart.channel_mix.revenue, mart.channel_mix.orders
filter core.fct_payment.status, core.fct_payment.paid_date -> core.fct_payment
filter core.fct_payment.status, core.fct_payment.paid_date -> mart.channel_mix
note D-17: the UPDATE's predicate decides which payments are settled and which are counted.

@ 117 S6 UPDATE SET CASE on a scalar subquery, EXISTS in WHERE
value core.dim_customer.segment -> core.dim_customer.segment conditional
value staging.orders.amount -> core.dim_customer.segment aggregated
# D-58: staging.orders.customer_id, core.dim_customer.customer_id matched the aggregated lookup's rows to core.dim_customer.segment's - influence, as a GROUP BY is (was a value).
influence staging.orders.customer_id, core.dim_customer.customer_id -> core.dim_customer.segment
note D-18: the subquery decides the CASE branch, so its sum and its correlation are values of segment.
filter staging.orders.customer_id, core.dim_customer.customer_id, staging.payments.status -> core.dim_customer
forbid filter staging.orders.amount -> core.dim_customer | inside a SET subquery: a value, not a filter (D-18)

@ 137 S7 INSERT of a UNION ALL, ON CONFLICT DO NOTHING, RETURNING
value core.fct_order_line.order_date, core.fct_payment.paid_date -> mart.sales_daily.sale_date identity
value core.fct_order_line.store_id -> mart.sales_daily.store_id identity
value core.fct_order_line.net_amount, core.fct_payment.amount -> mart.sales_daily.net_amount identity
filter core.fct_order_line.channel, core.fct_payment.method -> mart.sales_daily
value mart.sales_daily.sale_date -> <result>.sale_date identity
value mart.sales_daily.net_amount -> <result>.net_amount identity
filter core.fct_order_line.channel, core.fct_payment.method -> <result>

@ 154 S8 WITH ... DELETE ... USING a HAVING CTE
filter mart.customer_summary.status -> mart.customer_summary
filter staging.orders.order_ts -> mart.customer_summary post
note The CTE's HAVING decides which customers are dormant, so which rows are deleted.
forbid filter staging.orders.customer_id -> mart.customer_summary | `dm.customer_id = cs.customer_id` joins USING to the target (D-11)
