# Answer key for B3 t2_depth.sql - DML writes fed by deep sources.
#
# WRITTEN FROM SOURCE BEFORE THE ANALYSER WAS RUN OVER THIS FILE.
# Conventions: B1/B2 plus D-15..D-18 (not implemented).

@ 18 S1 WITH ... UPDATE ... FROM a four-CTE chain
value fct_order_line.net_amount -> customer_summary.lifetime_value aggregated
influence fct_order_line.customer_key -> customer_summary.lifetime_value, customer_summary.value_decile
influence fct_order_line.net_amount -> customer_summary.value_decile
note value_decile is NTILE over SUM(net_amount): no value source; its ordering and b's grouping reach it.
filter fct_order_line.order_date, fct_order_line.status -> customer_summary
filter fct_order_line.net_amount -> customer_summary post
note D-9: `c.decile >= 5` filters a window ordered by the SUM - post-aggregation.
forbid filter fct_order_line.customer_key -> customer_summary | joins d to the target in UPDATE ... FROM (D-11)

@ 48 S2 upsert from a UNION ALL over CTEs
value orders.customer_id -> customer_summary.customer_id identity
value orders.amount -> customer_summary.lifetime_value aggregated
influence orders.customer_id -> customer_summary.lifetime_value, customer_summary.lifetime_orders
filter orders.channel -> customer_summary
forbid filter orders.customer_id -> customer_summary | the conflict target is structural (D-15)

@ 71 S3 MERGE with a five-level USING
value fct_order_line.product_key -> product_performance.product_id identity
value fct_order_line.order_date -> product_performance.period_month derived
value fct_order_line.net_amount -> product_performance.revenue aggregated
value fct_order_line.quantity -> product_performance.units aggregated
influence fct_order_line.product_key, fct_order_line.order_date -> product_performance.revenue, product_performance.units
filter fct_order_line.status -> product_performance
filter fct_order_line.quantity -> product_performance post
forbid filter fct_order_line.product_key -> product_performance | the MERGE ON is structural (D-5)

@ 105 S4 three writes chained through RETURNING (D-16, D-17)
value fct_payment.order_id -> channel_mix.orders identity
value fct_payment.amount -> channel_mix.revenue identity
filter fct_shipment.delivered_date, fct_shipment.shipped_date -> fct_shipment
filter fct_shipment.delivered_date, fct_shipment.shipped_date -> fct_payment
filter fct_shipment.delivered_date, fct_shipment.shipped_date -> channel_mix
note D-17: upd's predicate decides which order_ids reach del's IN, so which payments are deleted and archived.
filter fct_payment.order_id, fct_shipment.order_id, fct_payment.status -> fct_payment
filter fct_payment.order_id, fct_shipment.order_id, fct_payment.status -> channel_mix
note fct_shipment.order_id is u.order_id, returned by upd and compared in del's IN.

@ 126 S5 INSERT ... RETURNING counted by the next INSERT
value customers.id -> top_customers.customer_id identity
value customers.full_name -> top_customers.full_name identity
value top_customers.customer_id -> kpi_rollup.customers aggregated
note D-16: the returned column is the written table's column; COUNT of it.
filter customers.segment -> top_customers
filter customers.segment -> kpi_rollup

@ 143 S6 WITH ... DELETE driven by HAVING and a correlated comparison
filter dim_product.product_id, inventory_snapshots.product_id, dim_product.list_price, dim_product.category_id -> dim_product
filter inventory_snapshots.snapshot_date, dim_product.list_price -> dim_product post

@ 161 S7 UPDATE ... FROM an aggregating derived table
value fct_order_line.order_date -> dim_store.opened_on aggregated
influence fct_order_line.store_id -> dim_store.opened_on
forbid filter fct_order_line.store_id -> dim_store | `x.store_id = s.id` joins the derived table to the target (D-11)

@ 176 S8 WITH ... MERGE ... RETURNING (D-16)
value dim_warehouse.name -> dim_store.name identity
filter dim_warehouse.status -> dim_store
value dim_store.id -> <result>.store_id identity
value dim_store.name -> <result>.store_name identity
filter dim_warehouse.status -> <result>
note merge_action() reports which arm ran: no source. USING's filter decides which rows are merged and returned.
forbid filter dim_warehouse.id -> dim_store | the MERGE ON is structural (D-5)
