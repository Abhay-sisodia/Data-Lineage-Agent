# Answer key for B4 t5_metamorphic.sql - expressions and types, metamorphic.
#
# WRITTEN FROM SOURCE BEFORE THE ANALYSER WAS RUN OVER THIS FILE.
# Conventions: all of B1-B3, plus D-19..D-22. Each pair's two halves carry the same
# facts; the pair check in triage.py compares them independently of this key.

@ 18 P1A COALESCE(x, 0)
value core.fct_order_line.order_date -> mart.sales_daily.sale_date identity
value core.fct_order_line.net_amount -> mart.sales_daily.net_amount derived
@ 23 P1B CASE WHEN x IS NULL
repeat value core.fct_order_line.order_date -> mart.sales_daily.sale_date identity
repeat value core.fct_order_line.net_amount -> mart.sales_daily.net_amount derived
forbid value core.fct_order_line.net_amount -> mart.sales_daily.net_amount conditional | the CASE spelling of a one-column guard is derived, like COALESCE (D-19)

@ 30 P2A GREATEST(x, 0)
repeat value core.fct_order_line.order_date -> mart.sales_daily.sale_date identity
value core.fct_order_line.gross_amount -> mart.sales_daily.gross_amount derived
@ 35 P2B CASE clamp
repeat value core.fct_order_line.order_date -> mart.sales_daily.sale_date identity
repeat value core.fct_order_line.gross_amount -> mart.sales_daily.gross_amount derived

@ 42 P3A NULLIF(x, 0)
repeat value core.fct_order_line.order_date -> mart.sales_daily.sale_date identity
value core.fct_order_line.quantity -> mart.sales_daily.units derived
@ 47 P3B CASE to NULL
repeat value core.fct_order_line.order_date -> mart.sales_daily.sale_date identity
repeat value core.fct_order_line.quantity -> mart.sales_daily.units derived

@ 54 P4A COALESCE(a, b)
repeat value core.fct_order_line.order_date -> mart.sales_daily.sale_date identity
value core.fct_order_line.net_amount, core.fct_order_line.gross_amount -> mart.sales_daily.avg_order_value conditional
@ 59 P4B CASE a ELSE b
repeat value core.fct_order_line.order_date -> mart.sales_daily.sale_date identity
repeat value core.fct_order_line.net_amount -> mart.sales_daily.avg_order_value conditional
repeat value core.fct_order_line.gross_amount -> mart.sales_daily.avg_order_value conditional

@ 68 P5A ::numeric
value staging.orders.channel -> mart.channel_mix.channel identity
value staging.orders.amount -> mart.channel_mix.revenue derived
@ 73 P5B CAST
repeat value staging.orders.channel -> mart.channel_mix.channel identity
repeat value staging.orders.amount -> mart.channel_mix.revenue derived

@ 80 P6A ||
value staging.customers.id -> core.dim_customer.customer_key identity
value staging.customers.full_name, staging.customers.email -> core.dim_customer.full_name derived
@ 85 P6B concat
repeat value staging.customers.id -> core.dim_customer.customer_key identity
repeat value staging.customers.full_name -> core.dim_customer.full_name derived
repeat value staging.customers.email -> core.dim_customer.full_name derived

@ 92 P7A EXTRACT
repeat value staging.orders.channel -> mart.channel_mix.channel identity
value staging.orders.order_ts -> mart.channel_mix.orders derived
@ 97 P7B date_part
repeat value staging.orders.channel -> mart.channel_mix.channel identity
repeat value staging.orders.order_ts -> mart.channel_mix.orders derived

@ 104 P8A IN list
repeat value staging.orders.channel -> mart.channel_mix.channel identity
value staging.orders.amount -> mart.channel_mix.revenue identity
filter staging.orders.currency -> mart.channel_mix
@ 110 P8B = ANY(ARRAY)
repeat value staging.orders.channel -> mart.channel_mix.channel identity
repeat value staging.orders.amount -> mart.channel_mix.revenue identity
repeat filter staging.orders.currency -> mart.channel_mix

@ 118 P9A IS DISTINCT FROM
repeat value staging.orders.channel -> mart.channel_mix.channel identity
value staging.orders.currency -> mart.channel_mix.region identity
filter staging.orders.status, staging.orders.discount_code -> mart.channel_mix
@ 124 P9B expanded
repeat value staging.orders.channel -> mart.channel_mix.channel identity
repeat value staging.orders.currency -> mart.channel_mix.region identity
repeat filter staging.orders.status -> mart.channel_mix
repeat filter staging.orders.discount_code -> mart.channel_mix

@ 133 P10A (c).field
value staging.customers.id -> mart.top_customers.customer_id identity
value staging.customers.full_name -> mart.top_customers.full_name identity
filter staging.customers.status -> mart.top_customers
@ 139 P10B c.field
repeat value staging.customers.id -> mart.top_customers.customer_id identity
repeat value staging.customers.full_name -> mart.top_customers.full_name identity
repeat filter staging.customers.status -> mart.top_customers

@ 156 R1 pricing, conversion and banding model
value staging.order_lines.product_id -> mart.product_performance.product_id identity
value staging.order_lines.unit_price, staging.order_lines.discount_pct, staging.order_lines.quantity, staging.products.cost, staging.fx_rates.rate_to_usd -> mart.product_performance.category_name aggregated
value core.dim_category.name -> mart.product_performance.category_name conditional
note The band CASE reads margin, rev and cat.name: conditional; the SUMs dominate their own paths.
value staging.orders.order_ts -> mart.product_performance.period_month derived
value staging.order_lines.quantity -> mart.product_performance.units aggregated
value staging.order_lines.unit_price, staging.order_lines.discount_pct, staging.order_lines.quantity, staging.fx_rates.rate_to_usd -> mart.product_performance.revenue, mart.product_performance.revenue_share, mart.product_performance.growth_pct aggregated
value staging.order_lines.unit_price, staging.order_lines.discount_pct, staging.order_lines.quantity, staging.products.cost, staging.fx_rates.rate_to_usd -> mart.product_performance.margin aggregated
influence staging.order_lines.product_id, staging.products.category_id, staging.orders.order_ts -> mart.product_performance.category_name, mart.product_performance.units, mart.product_performance.revenue, mart.product_performance.margin, mart.product_performance.revenue_share, mart.product_performance.growth_pct
note monthly's GROUP BY keys, and the windows' PARTITION BY / ORDER BY over them (D-2, D-4).
filter staging.order_lines.status, staging.orders.order_ts -> mart.product_performance
filter staging.order_lines.quantity -> mart.product_performance post
note GREATEST(units, 0) > 0 tests SUM(quantity): post-aggregation (B2-06).
forbid filter staging.fx_rates.rate_date -> mart.product_performance | an ON condition is structural (D-5), and fx is on a LEFT JOIN's null side (D-14)
forbid filter staging.fx_rates.rate_to_usd -> mart.product_performance | the rate is on a LEFT JOIN's null side (D-14)
forbid filter core.dim_category.id -> mart.product_performance | the ON is structural (D-5)
forbid influence staging.orders.order_ts -> mart.product_performance.period_month | a grouping key does not influence itself (D-2)
