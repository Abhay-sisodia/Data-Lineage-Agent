# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ANTLR - generated parser sources and the tool jar.
# Generated code is reproducible from the grammar; the jar is a large binary.
# Both are rebuilt by scripts/generate_parser.py.
src/lineage/parsing/generated/
tools/*.jar

# Oracle XE container state
.oracle-data/

# Corpus material that is not ours to redistribute.
# Sanitised real packages NEVER go in git - they live outside the repo.
corpus/restricted/

# Harness output - results are recorded in the tracker, not committed as noise.
out/
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Torture tests over user-supplied SQL: run locally, kept out of git (decided 2026-10-05).
stress/pg/torture*/
# The final PostgreSQL acceptance suite was local until 2026-10-09; it is now committed so
# the review bundle (docker-compose.review.yml) can demo it from a clean clone.

# Agent answer cache and traces (lineage ask), per machine.
.lineage_cache/

# Local secrets for the review bundle (ANTHROPIC_API_KEY); .env.example is the template.
.env
